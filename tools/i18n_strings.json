 "/* Шрифт интерфейса. Кириллица и латиница отдельными подмножествами: браузер тянет только нужное. Системный моноширинный, который был раньше, и делал интерфейс похожим на отладочный оверлей. */ @font-face { font-family: 'Worms UI'; font-style: normal; font-weight: 700; font-display: block; src: url('./assets/font/nunito-700-cyrillic.woff2') format('woff2'); unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116; } @font-face { font-family: 'Worms UI'; font-style: normal; font-weight: 700; font-display: block; src: url('./assets/font/nunito-700-latin.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+2000-206F, U+2122, U+2191-2193, U+2212, U+2215; } @font-face { font-family: 'Worms UI'; font-style: normal; font-weight: 800; font-display: block; src: url('./assets/font/nunito-800-cyrillic.woff2') format('woff2'); unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116; } @font-face { font-family: 'Worms UI'; font-style: normal; font-weight: 800; font-display: block; src: url('./assets/font/nunito-800-latin.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+2000-206F, U+2122, U+2191-2193, U+2212, U+2215; } html, body { margin: 0; padding: 0; width: 100%; /* 100% на iOS — это «большой» вьюпорт, тот, что без панели браузера: верх страницы уезжает под адресную строку. dvh — реально видимая высота прямо сейчас; 100% оставлен запасным для старых браузеров. */ height: 100%; height: 100dvh; background: #0b1021; overflow: hidden; overscroll-behavior: none; touch-action: none; -webkit-user-select: none; user-select: none; -webkit-tap-highlight-color: transparent; font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; } /* Канвас на весь экран, включая «чёлку» и полосу под кнопками Telegram: мир рисуется до краёв, а интерфейс сам отступает внутрь (CFG.FRAME). */ #game { position: fixed; inset: 0; } #game canvas { touch-action: none; } /* Диагностика экрана: включается пятью тапами по подписи внизу меню */ #diag { position: fixed; left: 8px; top: 8px; z-index: 30; display: none; padding: 8px 10px; background: rgba(0,0,0,0.75); color: #9fe0a0; font: 11px/1.4 ui-monospace, Menlo, monospace; white-space: pre; pointer-events: none; border-radius: 6px; } /* Щуп для безопасной области вне Telegram: JS читает env() через него */ #safe-probe { position: fixed; visibility: hidden; pointer-events: none; padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px) env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px); } #game canvas { display: block; } #gate { position: fixed; inset: 0; z-index: 20; display: none; flex-direction: column; align-items: center; justify-content: center; gap: 18px; background: #0b1021; color: #c3cee0; text-align: center; padding: 24px; font: 700 16px/1.5 'Worms UI', system-ui, sans-serif; } #gate .gate-title { font-size: 44px; font-weight: 800; color: #ffc247; letter-spacing: 2px; } #gate a { padding: 14px 26px; border-radius: 12px; background: linear-gradient(#3aa0e8, #1f6fb5); color: #fff; text-decoration: none; font-weight: 800; } #gate form { display: flex; flex-direction: column; gap: 10px; width: min(320px, 90vw); margin-top: 8px; } #gate input { padding: 12px 14px; border-radius: 10px; border: 2px solid #2a3550; background: #141b30; color: #fff; font: 700 16px 'Worms UI', system-ui, sans-serif; } #gate button { padding: 14px; border: 0; border-radius: 12px; background: linear-gradient(#ffd166, #e09a2a); color: #2a1c06; font: 800 17px 'Worms UI', system-ui, sans-serif; cursor: pointer; } #gate button:disabled { opacity: 0.6; } #gate .gate-error { color: #ff9a9a; min-height: 1.4em; } #fatal { position: fixed; inset: 0; display: none; align-items: center; justify-content: center; color: #ffb4b4; background: #0b1021; text-align: center; padding: 24px; line-height: 1.5; font-size: 15px; } /* Бой ландшафтный: в портрете видна четверть карты, поэтому вместо него показываем просьбу повернуть устройство. */ #rotate { position: fixed; inset: 0; display: none; z-index: 10; flex-direction: column; align-items: center; justify-content: center; gap: 18px; background: #0b1021; color: #c3cee0; text-align: center; padding: 24px; line-height: 1.5; font-size: 16px; } #rotate .phone { width: 54px; height: 92px; border: 3px solid #6ecbff; border-radius: 10px; animation: tilt 1.8s ease-in-out infinite; } @keyframes tilt { 0%, 40% { transform: rotate(0deg); } 60%, 100% { transform: rotate(-90deg); } } /* Меню и лобби работают в любой ориентации, повернуть просит только бой: класс in-battle ставит игровая сцена */ @media (orientation: portrait) and (max-width: 900px) { body.in-battle #rotate { display: flex; } } /* На ПК подсказка про узкое окно, а не про поворот телефона */ .desktop-only { display: none; } body.ui-desktop .desktop-only { display: block; } body.ui-desktop .touch-only, body.ui-desktop #rotate .phone { display: none; }": "index.html",
