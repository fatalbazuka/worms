{
  "name": "worms-prototype",
  "version": "0.3.0",
  "private": true,
  "description": "Пошаговая артиллерийская игра в духе Worms для браузера и Telegram: аккаунты и рейтинг на своём сервере, мышь и клавиатура на ПК, тач на телефоне",
  "type": "module",
  "scripts": {
    "dev": "STATIC_DIR=. PORT=5173 DB_PATH=./data/dev.db node --disable-warning=ExperimentalWarning server/index.mjs",
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "build": "node tools/build.mjs",
    "test": "node tests/run.mjs",
    "backup": "node --disable-warning=ExperimentalWarning server/backup.mjs",
    "assets": "python3 tools/build_assets.py",
    "docker:up": "docker compose up -d --build"
  },
  "devDependencies": {
    "playwright": "^1.47.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
