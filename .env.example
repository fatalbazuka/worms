# Скопируй в .env и заполни. Пустые значения — настройки по умолчанию из кода.

# --- Сервер ---
# Игра не в корне домена, а по пути (https://домен/worms): путь без слэша
# на конце. Пусто — в корне. Для Caddy вместе с этим CADDYFILE=Caddyfile.subpath
WORMS_PATH=
CADDYFILE=Caddyfile
# Домен для HTTPS (профиль https в docker-compose). Должен смотреть на сервер.
DOMAIN=worms.example.com
# Где слушает контейнер игры. С профилем https: HTTP_BIND=127.0.0.1
HTTP_BIND=0.0.0.0
HTTP_PORT=8080

# --- Сетевая игра (Supabase Realtime) ---
# Публичный адрес проекта и publishable/anon-ключ. Ключ service_role
# сюда НЕ класть: env.js уходит в браузер каждому игроку.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_LEGACY_KEY=

# --- Telegram-бот (игра живёт в нём) ---
# Токен бота от @BotFather — СЕКРЕТ: уходит только в контейнер api, в браузер
# не попадает. Без него нет входа, кабинета, рейтинга, турниров и звёзд.
TELEGRAM_BOT_TOKEN=
# Имя бота без @ — для ссылок t.me/бот (приглашения, экран «открой в Telegram»)
TELEGRAM_BOT=
# Короткое имя Mini App — только если он заведён через /newapp
TELEGRAM_APP=
# Адрес игры снаружи, как его открывает Telegram, без слэша на конце.
# По нему бот сам ставит вебхук (PUBLIC_URL/api/bot/webhook) и кнопку «Играть».
PUBLIC_URL=https://fatalbazuka.ru/worms
# Твой Telegram ID (числом; узнать — @userinfobot). Через запятую, если
# админов несколько. Админ создаёт турниры и делает возвраты командами бота.
ADMIN_TG_IDS=
# Часовой пояс для «/newtour 8 20:00»
BOT_TZ=Europe/Moscow
# 1 — в обычном браузере вместо игры ссылка на бота; 0 — играть можно и так
TELEGRAM_ONLY=1

# --- Сервер игры ---
# Адрес API для браузера; пусто — api/ рядом со страницей игры (в корне
# домена это /api, под /worms — /worms/api). Обычно трогать не нужно.
WORMS_API=

# --- Интерфейс ---
# desktop | touch — навязать всем; пусто — по устройству
WORMS_UI=
