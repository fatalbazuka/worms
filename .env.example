# Скопируй в .env и заполни. Пустые значения — настройки по умолчанию из кода.

# --- Сервер ---
# Домен для HTTPS (профиль https в docker-compose). Должен смотреть на сервер.
DOMAIN=worms.example.com
# Где слушает контейнер игры. С профилем https: HTTP_BIND=127.0.0.1
HTTP_BIND=0.0.0.0
HTTP_PORT=8080

# --- Сетевая игра (Supabase Realtime) ---
# Публичный адрес проекта и publishable/anon-ключ. Ключ service_role
# сюда НЕ класть: env.js уходит в браузер каждому игроку.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_LEGACY_KEY=

# --- Telegram Mini App ---
# Имя бота без @; TELEGRAM_APP — только если Mini App заведён через /newapp
TELEGRAM_BOT=
TELEGRAM_APP=

# --- Интерфейс ---
# desktop | touch — навязать всем; пусто — по устройству
WORMS_UI=
